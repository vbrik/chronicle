#!/usr/bin/env python3
"""Append a dated entry to one of several configured target files.

The entry text is gathered by opening $EDITOR on a temporary file prefilled
with a `# <target path>` sanity-check line, then "- " on the next line (for
vim/nvim, the editor is also dropped straight into insert mode after the
prefill); when the editor exits, that first line is dropped if left
unmodified, then the rest becomes today's entry, unless it's blank or
unchanged from the "- " prefill, in which case nothing is logged. Trailing
whitespace is stripped from every line, then leading and trailing newlines
are removed; the result is appended verbatim.

Each target file is organized as:

    ## August
    ### 2026-08-12, Wednesday
    entry one
    entry two

Targets are named by an arbitrary key and configured under a `[targets]`
section of a config file (by default ~/.config/chronicle/chronicle.conf,
overridable with --config), e.g.:

    [targets]
    0 = ~/notes/chronicle/2026-q3.md
    1 = ~/notes/inbox.md

The key to write to is given as a positional argument (`chronicle 1`);
omitted, it defaults to the first entry in `[targets]`.

The key `*` is special only in one way: if configured, every entry written
to any *other* target is also appended, verbatim, to the `*` target's file
(e.g. `* = ~/notes/everything.md`). Written to directly (`chronicle '*'`),
it's an ordinary target.
"""

import argparse
import configparser
import datetime
import os
import re
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import NoReturn

DEFAULT_CONFIG_PATH = Path("~/.config/chronicle/chronicle.conf").expanduser()
TARGETS_SECTION = "targets"
# Target key that additionally receives every entry written to any other target.
ALL_TARGETS_KEY = "*"


_DAY_HEADER_DATE_RE = re.compile(r"^### (\d{4})-(\d{2})-(\d{2})")


def last_day_header_date(lines: list[str]) -> tuple[int, int, int] | None:
    """(year, month, day) of the last `### YYYY-MM-DD[, Weekday]` heading, if any.

    Target files are no longer necessarily per-quarter, so a month name
    (and thus its "## <Month>" heading text) can recur across years; a day
    heading's full ISO date is what unambiguously says whether the file's
    last section already belongs to the current year-month.
    """
    for line in reversed(lines):
        m = _DAY_HEADER_DATE_RE.match(line)
        if m:
            return int(m[1]), int(m[2]), int(m[3])
    return None


def find_day_header(lines: list[str], iso_date: str) -> int | None:
    """Index of the `### <iso_date>[, Weekday]` heading line, if present.

    Matches by prefix so pre-existing headings without the weekday suffix
    (or with human-added trailing text) are still recognized.
    """
    needle = f"### {iso_date}"
    for i, line in enumerate(lines):
        if line.rstrip("\n").startswith(needle):
            return i
    return None


def trim_trailing_blank_lines(lines: list[str]) -> None:
    """Drop blank lines at the end of `lines`, in place."""
    while lines and lines[-1].strip() == "":
        lines.pop()


def section_end(lines: list[str], start: int) -> int:
    """Index just past the section starting at `start` (next heading or EOF)."""
    for i in range(start + 1, len(lines)):
        if lines[i].startswith("#"):
            return i
    return len(lines)


def insert_in_section(lines: list[str], start: int, entry: str) -> None:
    """Insert `entry` as the last line of the section starting at `start`."""
    end = section_end(lines, start)
    i = end
    while i > start + 1 and lines[i - 1].strip() == "":
        i -= 1
    lines.insert(i, entry + "\n")


def load_config_parser(config_path: Path) -> configparser.ConfigParser:
    """Parsed config file at `config_path`, exiting with a clean error on invalid syntax.

    Target keys are case-sensitive: configparser's default of lowercasing
    option names would otherwise silently collide keys like "A" and "a".

    Interpolation is disabled (`interpolation=None`): target values are
    plain file paths with no business being template-expanded, and a
    literal "%" in one (a fairly ordinary path character) would otherwise
    raise on read. `default_section` is renamed away from "DEFAULT" so a
    `[DEFAULT]` heading — a section name someone could plausibly use for
    an unrelated purpose in the same file — isn't silently merged into
    every other section, `[targets]` included.
    """
    parser = configparser.ConfigParser(
        default_section="_UNUSED_DEFAULT_SECTION_", interpolation=None
    )
    parser.optionxform = str
    try:
        parser.read(config_path)
    except configparser.Error as e:
        print(f"chronicle: invalid config file {config_path}: {e}", file=sys.stderr)
        raise SystemExit(1)
    return parser


def exit_with_targets_template(config_path: Path, key: str | None) -> NoReturn:
    """Print an actionable error plus a copy-pasteable [targets] template, then exit(1)."""
    if key is None:
        header = f"chronicle: no targets configured in {config_path}"
    else:
        header = f'chronicle: no target "{key}" configured in {config_path}'
    print(
        f"{header}\n"
        "\n"
        "Add entries like this to that file:\n"
        "\n"
        f"[{TARGETS_SECTION}]\n"
        "0 = ~/path/to/first/file.md\n"
        "1 = ~/path/to/second/file.md\n"
        "\n"
        "Then run: chronicle 0",
        file=sys.stderr,
    )
    raise SystemExit(1)


def resolve_target_path(
    config_path: Path, key: str | None, config_path_is_explicit: bool
) -> tuple[Path, Path | None]:
    """Resolve `key` (or the first configured target, if `key` is None) to its path.

    Returns `(path, mirror)`, where `mirror` is the path of the special
    `ALL_TARGETS_KEY` target that every entry is also copied into, or None
    when there's nothing to mirror into: `*` is unconfigured or blank, is
    itself the target being written, or resolves to the same file as it.

    Exits via `exit_with_targets_template` if the config file/section/key
    can't provide an answer; exits with a distinct "file not found" error
    if `--config` was given explicitly and doesn't exist.
    """
    if config_path_is_explicit and not config_path.exists():
        print(f"chronicle: config file not found: {config_path}", file=sys.stderr)
        raise SystemExit(1)

    parser = load_config_parser(config_path)
    if not parser.has_section(TARGETS_SECTION):
        exit_with_targets_template(config_path, key)

    targets = parser[TARGETS_SECTION]
    if key is None:
        if not targets:
            exit_with_targets_template(config_path, key)
        key = next(iter(targets))

    value = targets.get(key)
    if not value:
        exit_with_targets_template(config_path, key)
    path = Path(value).expanduser().resolve()

    mirror = None
    if key != ALL_TARGETS_KEY and (all_value := targets.get(ALL_TARGETS_KEY)):
        mirror = Path(all_value).expanduser().resolve()
        if mirror == path:
            mirror = None

    return path, mirror


_CURSOR_FLAGS_BY_EDITOR = {
    "vim": ["-c", "$", "-c", "startinsert!"],
    "nvim": ["-c", "$", "-c", "startinsert!"],
}


def cursor_flags(editor_argv: list[str]) -> list[str]:
    """Extra argv flags that place the cursor at the end of the "- " prefill
    line, for editors whose command-line syntax for this is known and safe.

    Two lines are prefilled (the target-path header, then "- "), so the
    editor opens with the cursor on line 1 by default; `-c $` jumps to the
    last line first, then `-c startinsert!` enters insert mode there (the
    `!` means "at end of line", so exact column position after `$` doesn't
    matter).

    Matched by executable basename. Only vim/nvim are recognized: an
    unrecognized or wrong flag risks being parsed as a second filename
    instead of an option, which would silently edit a different buffer and
    leave the "- "-only temp file looking unmodified (see `is_blank_entry`)
    — i.e. the entry gets silently dropped. Plain "vi" is deliberately
    excluded since its traditional ex-command set lacks `:startinsert`.
    """
    if not editor_argv:
        return []
    exe = Path(editor_argv[0]).name
    return list(_CURSOR_FLAGS_BY_EDITOR.get(exe, []))


def edit_entry(path: Path) -> str:
    """Open $EDITOR on a temporary file prefilled with a `# <path>`
    sanity-check line and "- " below it, and return its contents on exit.

    Falls back to `vi` when $EDITOR is unset. For vim/nvim, extra flags are
    added (see `cursor_flags`) so the editor opens in insert mode right
    after the "- " prefill; other editors are left untouched. Returns the
    raw file contents, header line and "- " prefix included; callers are
    responsible for stripping/validating (see `strip_target_header_line`
    and `is_blank_entry`).
    """
    editor = os.environ.get("EDITOR") or "vi"
    cmd = shlex.split(editor)
    # Inserted right after the executable, not appended last: a trailing
    # user-supplied "--" would otherwise end option parsing and make vim
    # treat these flags as filenames instead.
    cmd[1:1] = cursor_flags(cmd)
    # NamedTemporaryFile with delete=False so we can reopen after the editor
    # closes it; we clean up ourselves in finally. The header line lets the
    # user confirm which file they're about to write into; "- " is the
    # conventional markdown bullet prefill.
    with tempfile.NamedTemporaryFile(
        mode="w", suffix=".md", delete=False, encoding="utf-8"
    ) as tf:
        tf.write(f"# {path}\n- ")
        tmp_path = tf.name
    try:
        cmd.append(tmp_path)
        subprocess.run(cmd, check=True)
        with open(tmp_path, encoding="utf-8") as f:
            return f.read()
    finally:
        os.unlink(tmp_path)


def strip_target_header_line(raw: str, path: Path) -> str:
    """Drop the injected `# <path>` sanity-check line from `raw`, if unmodified.

    Exact match only (not a loose "starts with #" pattern): a real entry
    that happens to start with a markdown heading of its own must never be
    silently eaten.
    """
    first, _, rest = raw.partition("\n")
    if first == f"# {path}":
        return rest
    return raw


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="chronicle",
        description=(
            "Append a dated entry to a configured target file. The entry "
            "is composed in $EDITOR (defaulting to vi)."
        ),
    )
    parser.add_argument(
        "target",
        nargs="?",
        default=None,
        metavar="KEY",
        help=(
            f"target key from [{TARGETS_SECTION}] in the config file "
            "(default: first entry); entries also go to the "
            f"'{ALL_TARGETS_KEY}' target, if configured"
        ),
    )
    parser.add_argument(
        "--config",
        type=Path,
        default=None,
        metavar="PATH",
        help=f"config file path (default: {DEFAULT_CONFIG_PATH})",
    )
    return parser.parse_args()


def format_entry(content: str) -> str:
    """Normalize raw editor content before appending.

    Trailing whitespace is stripped from every line, then leading and
    trailing newlines are removed. Beyond that, chronicle appends the text
    verbatim, "- " prefill included if the user built on it.
    """
    content = "\n".join(line.rstrip() for line in content.split("\n"))
    return content.strip("\n")


def is_blank_entry(entry: str) -> bool:
    """True if `entry` (already run through `format_entry`) has no real content.

    Covers both a fully empty/whitespace-only entry and the unmodified "-"
    bullet prefill left behind when the editor is closed without adding text.
    """
    return entry.strip() in ("", "-")


def append_entry(path: Path, entry: str, today: datetime.date) -> None:
    """Append `entry` under `today`'s day heading in `path`, creating headings as needed.

    The file (and its parent directories) is created if missing. Headings
    are decided from this file's own content alone, so the same entry can
    land in a fresh day section in one file and an existing one in another.
    """
    month_header = f"## {today.strftime('%B')}"
    day_header = f"### {today.isoformat()}, {today.strftime('%A')}"

    if path.exists():
        lines = path.read_text().splitlines(keepends=True)
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
        lines = []

    trim_trailing_blank_lines(lines)

    day_idx = find_day_header(lines, today.isoformat())
    if day_idx is not None:
        insert_in_section(lines, day_idx, entry)
    else:
        # Month heading, if newly created, directly follows prior content
        # (no blank line); the day heading always gets one blank line
        # before it to set the new day visually apart.
        last_date = last_day_header_date(lines)
        if last_date is None or last_date[:2] != (today.year, today.month):
            lines.append(month_header + "\n")
        lines.append("\n")
        lines.append(day_header + "\n")
        lines.append(entry + "\n")

    path.write_text("".join(lines))


def main() -> int:
    args = parse_args()

    config_path_is_explicit = args.config is not None
    config_path = args.config.expanduser() if args.config else DEFAULT_CONFIG_PATH
    path, mirror = resolve_target_path(
        config_path, args.target, config_path_is_explicit
    )

    raw = edit_entry(path)
    entry = format_entry(strip_target_header_line(raw, path))
    if is_blank_entry(entry):
        # Nothing meaningful was entered: nothing to log, not an error.
        return 0

    # Naive local date on purpose: entries are filed under the user's
    # wall-clock day, whatever timezone they happen to be in.
    today = datetime.date.today()  # noqa: DTZ011
    append_entry(path, entry, today)
    if mirror is not None:
        append_entry(mirror, entry, today)
    print(entry)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
