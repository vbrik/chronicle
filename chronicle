#!/usr/bin/env python3
"""Append an entry to today's section of the current chronicle file.

The entry text is gathered by opening $EDITOR on a temporary file; when the
editor exits, the (non-empty) file contents become today's entry. Trailing
whitespace is stripped from every line, then leading and trailing newlines are
removed; the result is appended verbatim (the user is responsible for any
markdown formatting).

The chronicle file lives at <root>/<year>-q<quarter>.md and is organized as:

    # 2026 Q3
    ## August
    ### 2026-08-12, Wednesday
    entry one
    entry two

The root directory is read, in order of precedence, from the CHRONICLE_ROOT_DIR
environment variable, then the `root_dir` setting of a config file (by default
~/.config/chronicle/chronicle.conf, overridable with --config). If neither is
set, the tool interactively offers to write the root directory to the default
config file location.
"""

import argparse
import configparser
import datetime
import os
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

ENV_VAR = "CHRONICLE_ROOT_DIR"
DEFAULT_CONFIG_PATH = Path("~/.config/chronicle/chronicle.conf").expanduser()
CONFIG_SECTION = "chronicle"
CONFIG_KEY = "root_dir"


def quarter_of(date: datetime.date) -> int:
    """Return the 1-4 calendar quarter containing `date`."""
    return (date.month - 1) // 3 + 1


def chronicle_path(date: datetime.date, chronicle_dir: Path) -> Path:
    """Path of the quarterly chronicle file that `date` belongs to."""
    return chronicle_dir / f"{date.year}-q{quarter_of(date)}.md"


def find_month_header(lines: list[str], month_header: str) -> int | None:
    """Index of the `## <Month>` heading line, if present."""
    for i, line in enumerate(lines):
        if line.rstrip("\n") == month_header:
            return i
    return None


def find_day_header(lines: list[str], iso_date: str) -> int | None:
    """Index of the `### <iso_date>[, Weekday]` heading line, if present.

    Matches by prefix so pre-existing headings without the weekday suffix
    (or with human-added trailing text) are still recognized.
    """
    needle = f"### {iso_date}"
    for i, line in enumerate(lines):
        if line.rstrip("\n").startswith(needle):
            return i
    return None


def trim_trailing_blank_lines(lines: list[str]) -> None:
    """Drop blank lines at the end of `lines`, in place."""
    while lines and lines[-1].strip() == "":
        lines.pop()


def section_end(lines: list[str], start: int) -> int:
    """Index just past the section starting at `start` (next heading or EOF)."""
    for i in range(start + 1, len(lines)):
        if lines[i].startswith("#"):
            return i
    return len(lines)


def insert_in_section(lines: list[str], start: int, entry: str) -> None:
    """Insert `entry` as the last line of the section starting at `start`."""
    end = section_end(lines, start)
    i = end
    while i > start + 1 and lines[i - 1].strip() == "":
        i -= 1
    lines.insert(i, entry + "\n")


def load_config_parser(config_path: Path) -> configparser.ConfigParser:
    """Parsed config file at `config_path`, exiting with a clean error on invalid syntax."""
    parser = configparser.ConfigParser()
    try:
        parser.read(config_path)
    except configparser.Error as e:
        print(f"chronicle: invalid config file {config_path}: {e}", file=sys.stderr)
        raise SystemExit(1)
    return parser


def read_config_root_dir(config_path: Path) -> str | None:
    """Value of `root_dir` in `config_path`, or None if unset/missing."""
    if not config_path.exists():
        return None
    parser = load_config_parser(config_path)
    return parser.get(CONFIG_SECTION, CONFIG_KEY, fallback=None)


def write_config_root_dir(config_path: Path, root_dir: str) -> None:
    """Set `root_dir` in `config_path`, preserving other settings."""
    parser = load_config_parser(config_path)
    if not parser.has_section(CONFIG_SECTION):
        parser.add_section(CONFIG_SECTION)
    parser.set(CONFIG_SECTION, CONFIG_KEY, root_dir)
    config_path.parent.mkdir(parents=True, exist_ok=True)
    with config_path.open("w") as f:
        parser.write(f)


def prompt_for_root_dir(config_path: Path) -> Path:
    """Interactively ask for a root directory and persist it to `config_path`.
    Exits the process if not running interactively or if the answer is blank.
    """
    if not sys.stdin.isatty():
        print(
            f"chronicle: no root directory configured; set {ENV_VAR} or "
            f"'{CONFIG_KEY}' under [{CONFIG_SECTION}] in {config_path}",
            file=sys.stderr,
        )
        raise SystemExit(1)

    answer = input(
        f"chronicle: no root directory configured. Enter one to save to {config_path}: "
    ).strip()
    if not answer:
        print("chronicle: no root directory given", file=sys.stderr)
        raise SystemExit(1)

    write_config_root_dir(config_path, answer)
    return Path(answer).expanduser().resolve()


def resolve_chronicle_dir(config_path: Path, config_path_is_explicit: bool) -> Path:
    """Root directory for chronicle files, per the documented precedence."""
    env_value = os.environ.get(ENV_VAR)
    if env_value:
        return Path(env_value).expanduser().resolve()

    if config_path_is_explicit and not config_path.exists():
        print(f"chronicle: config file not found: {config_path}", file=sys.stderr)
        raise SystemExit(1)

    config_value = read_config_root_dir(config_path)
    if config_value:
        return Path(config_value).expanduser().resolve()

    return prompt_for_root_dir(config_path)


def edit_entry() -> str:
    """Open $EDITOR on a temporary file and return its contents on exit.

    Falls back to `vi` when $EDITOR is unset. Returns the raw file contents;
    callers are responsible for stripping/validating.
    """
    editor = os.environ.get("EDITOR") or "vi"
    cmd = shlex.split(editor)
    # NamedTemporaryFile with delete=False so we can reopen after the editor
    # closes it; we clean up ourselves in finally.
    with tempfile.NamedTemporaryFile(
        mode="w", suffix=".md", delete=False, encoding="utf-8"
    ) as tf:
        path = tf.name
    try:
        cmd.append(path)
        subprocess.run(cmd, check=True)
        with open(path, encoding="utf-8") as f:
            return f.read()
    finally:
        os.unlink(path)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="chronicle",
        description=(
            "Append an entry to today's section of the current chronicle "
            "file. The entry is composed in $EDITOR (defaulting to vi)."
        ),
    )
    parser.add_argument(
        "--config",
        type=Path,
        default=None,
        metavar="PATH",
        help=f"config file path (default: {DEFAULT_CONFIG_PATH})",
    )
    return parser.parse_args()


def format_entry(content: str) -> str:
    """Normalize raw editor content before appending.

    Trailing whitespace is stripped from every line, then leading and
    trailing newlines are removed. The user is responsible for any
    markdown formatting; chronicle just appends the text verbatim.
    """
    content = "\n".join(line.rstrip() for line in content.split("\n"))
    return content.strip("\n")


def main() -> int:
    args = parse_args()

    raw = edit_entry()
    entry = format_entry(raw)
    if not entry.strip():
        # Empty temp file: nothing to log, not an error.
        return 0

    config_path_is_explicit = args.config is not None
    config_path = args.config.expanduser() if args.config else DEFAULT_CONFIG_PATH
    chronicle_dir = resolve_chronicle_dir(config_path, config_path_is_explicit)

    today = datetime.date.today()
    path = chronicle_path(today, chronicle_dir)
    month_header = f"## {today.strftime('%B')}"
    day_header = f"### {today.isoformat()}, {today.strftime('%A')}"

    if path.exists():
        lines = path.read_text().splitlines(keepends=True)
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
        lines = [f"# {today.year} Q{quarter_of(today)}\n"]

    trim_trailing_blank_lines(lines)

    day_idx = find_day_header(lines, today.isoformat())
    if day_idx is not None:
        insert_in_section(lines, day_idx, entry)
    else:
        # Month heading, if newly created, directly follows prior content
        # (no blank line); the day heading always gets one blank line
        # before it to set the new day visually apart.
        if find_month_header(lines, month_header) is None:
            lines.append(month_header + "\n")
        lines.append("\n")
        lines.append(day_header + "\n")
        lines.append(entry + "\n")

    path.write_text("".join(lines))
    print(entry)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
