#!/usr/bin/env python3
"""Append a bullet entry to today's section of the current chronicle file."""
import datetime
import sys
from pathlib import Path

CHRONICLE_FILE = Path("~/proj/notes/notes/chronicles/2026-q3.md").expanduser()


def find_header(lines: list[str], header: str) -> int | None:
    for i, line in enumerate(lines):
        if line.rstrip("\n") == header:
            return i
    return None


def section_end(lines: list[str], start: int) -> int:
    for i in range(start + 1, len(lines)):
        if lines[i].startswith("#"):
            return i
    return len(lines)


def insert_in_section(lines: list[str], start: int, bullet: str) -> None:
    end = section_end(lines, start)
    i = end
    while i > start + 1 and lines[i - 1].strip() == "":
        i -= 1
    lines.insert(i, bullet + "\n")


def append_new_section(lines: list[str], header_lines: list[str]) -> None:
    if lines and lines[-1].strip() != "":
        lines.append("\n")
    for h in header_lines:
        lines.append(h + "\n")


def main() -> int:
    entry = " ".join(sys.argv[1:]).strip()
    entry = " ".join(entry.split("\n"))
    if not entry:
        print("usage: chronicle <entry text>", file=sys.stderr)
        return 1

    if not CHRONICLE_FILE.exists():
        print(f"error: chronicle file not found: {CHRONICLE_FILE}", file=sys.stderr)
        return 1

    today = datetime.date.today()
    day_header = f"### {today.isoformat()}"
    month_header = f"## {today.strftime('%B')}"
    bullet = f"- {entry}"

    lines = CHRONICLE_FILE.read_text().splitlines(keepends=True)
    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"

    day_idx = find_header(lines, day_header)
    if day_idx is not None:
        insert_in_section(lines, day_idx, bullet)
    else:
        month_idx = find_header(lines, month_header)
        if month_idx is not None:
            append_new_section(lines, [day_header, bullet])
        else:
            append_new_section(lines, [month_header, day_header, bullet])

    CHRONICLE_FILE.write_text("".join(lines))
    print(bullet)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
